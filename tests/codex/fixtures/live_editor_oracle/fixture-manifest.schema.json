{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["fixture_version", "project", "files", "phases"],
  "properties": {
    "fixture_version": {"const": 1},
    "project": {"const": "res://"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\\\][^\\\\]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "phases": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
