{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotengine.org/codex/resource-graph/fixture-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_version",
    "required_godot",
    "resources",
    "phases",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_version": {"type": "integer", "minimum": 1},
    "required_godot": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+"},
    "resources": {
      "type": "array",
      "minItems": 15,
      "items": {"$ref": "#/$defs/resource"}
    },
    "phases": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/phase"}
    },
    "exclusions": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["fallback_path", "resolution"],
      "properties": {
        "uid": {"type": ["string", "null"], "pattern": "^uid://"},
        "fallback_path": {"type": "string", "pattern": "^res://"},
        "target": {"type": ["string", "null"]},
        "resolution": {"enum": ["resolved", "missing", "stale_uid"]}
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "oracle_id",
        "path",
        "uid",
        "format",
        "type",
        "imported",
        "import_state",
        "hash_mode",
        "dependencies"
      ],
      "properties": {
        "oracle_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "path": {"type": "string", "pattern": "^res://"},
        "uid": {"type": ["string", "null"], "pattern": "^uid://"},
        "format": {"enum": ["tres", "res", "tscn", "scn", "imported"]},
        "type": {"type": "string", "minLength": 1},
        "imported": {"type": "boolean"},
        "import_state": {"enum": ["not_imported", "valid", "invalid"]},
        "hash_mode": {"enum": ["exact_sha256", "runtime_sha256"]},
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency"}
        }
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": ["name", "mutation", "assertions"],
      "properties": {
        "name": {
          "enum": [
            "base",
            "rename_uid",
            "rename_uidless",
            "delete",
            "re_add",
            "reimport",
            "content_edit",
            "journal_gap"
          ]
        },
        "mutation": {"type": "string", "minLength": 1},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
