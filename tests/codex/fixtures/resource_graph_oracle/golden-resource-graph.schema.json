{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotengine.org/codex/resource-graph/golden-resource-graph.schema.json",
  "type": "object",
  "required": ["schema_version", "fixture_version", "required_godot", "phases"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_version": {"type": "integer", "minimum": 1},
    "required_godot": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+"},
    "phases": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "hash_assertion": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["exact_sha256", "runtime_sha256"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "exact_sha256"}}},
          "then": {"required": ["sha256"]}
        }
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "oracle_id",
        "entity_id",
        "uid",
        "path",
        "format",
        "type",
        "identity_scope",
        "identity_strength",
        "imported",
        "import_state",
        "hash_assertion"
      ],
      "properties": {
        "oracle_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "entity_id": {"type": "string", "pattern": "^godot:resource:"},
        "uid": {"type": ["string", "null"], "pattern": "^uid://"},
        "path": {"type": "string", "pattern": "^res://"},
        "format": {"enum": ["tres", "res", "tscn", "scn", "imported"]},
        "type": {"type": "string", "minLength": 1},
        "identity_scope": {"enum": ["persistent", "content_revision"]},
        "identity_strength": {"enum": ["resource_uid", "path_content_generation"]},
        "imported": {"type": "boolean"},
        "import_state": {"enum": ["not_imported", "valid", "invalid"]},
        "content_generation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_assertion": {"$ref": "#/$defs/hash_assertion"}
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": [
        "edge_id",
        "source",
        "source_entity_id",
        "target_uid",
        "fallback_path",
        "resolved_target",
        "resolved_target_entity_id",
        "resolution",
        "authority"
      ],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^godot:edge:references:"},
        "source": {"type": "string", "minLength": 1},
        "source_entity_id": {"type": "string", "pattern": "^godot:resource:"},
        "target_uid": {"type": ["string", "null"], "pattern": "^uid://"},
        "fallback_path": {"type": "string", "pattern": "^res://"},
        "resolved_target": {"type": ["string", "null"]},
        "resolved_target_entity_id": {"type": ["string", "null"]},
        "resolution": {"enum": ["resolved", "missing", "stale_uid"]},
        "authority": {"const": "godot_resource_loader"}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "source", "target_reference", "silent_rebind"],
      "properties": {
        "code": {"enum": ["missing_dependency", "stale_resource_uid"]},
        "source": {"type": "string", "minLength": 1},
        "target_reference": {"type": "string", "minLength": 1},
        "silent_rebind": {"const": false}
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": [
        "name",
        "resources",
        "dependencies",
        "diagnostics",
        "expected_direct_queries",
        "transition",
        "exclusions"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "resources": {
          "type": "array",
          "minItems": 14,
          "items": {"$ref": "#/$defs/resource"}
        },
        "dependencies": {
          "type": "array",
          "minItems": 8,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "diagnostics": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "expected_direct_queries": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "pattern": "^godot:edge:references:"}
          }
        },
        "transition": {
          "type": "object",
          "required": ["from", "mutation", "assertions"],
          "properties": {
            "from": {"type": ["string", "null"]},
            "mutation": {"type": "string", "minLength": 1},
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        },
        "exclusions": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
