  "phases": [
    {
      "name": "base",
      "mutation": "none",
      "assertions": ["full_graph_matches"]
    },
    {
      "name": "rename_uid",
      "mutation": "move shared_leaf and update every fallback reference",
      "assertions": ["same_entity_id", "reverse_owners_update", "no_full_rebuild"]
    },
    {
      "name": "rename_uidless",
      "mutation": "move twin_a without a UID",
      "assertions": ["old_identity_removed", "new_identity_inserted"]
    },
    {
      "name": "delete",
      "mutation": "remove unique_leaf",
      "assertions": ["stale_uid_edge_preserved", "inbound_diagnostic_active"]
    },
    {
      "name": "re_add",
      "mutation": "delete and restore unique_leaf at the same path and UID",
      "assertions": ["delete_then_upsert", "same_uid_entity_id", "diagnostic_resolved"]
    },
    {
      "name": "reimport",
      "mutation": "change imported SVG source bytes",
      "assertions": ["same_uid_entity_id", "content_generation_changes", "import_valid"]
    },
    {
      "name": "content_edit",
      "mutation": "change shared_leaf source bytes",
      "assertions": ["same_uid_entity_id", "content_generation_changes"]
    },
    {
      "name": "journal_gap",
      "mutation": "omit one event from the synthetic transition trace",
      "assertions": ["resource_journal_gap", "full_snapshot_required", "no_guessed_delta"]
    }
  ],
  "exclusions": [
    ".godot/",
    ".godot/imported/",
