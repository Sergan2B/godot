{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-codex.invalid/schemas/sprint11-host-delta-measurement.schema.json",
  "title": "Sprint 11 Codex host delta measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "package",
    "surfaces",
    "client_groups",
    "feature_projection",
    "app_server_projection",
    "contract_projection_sha256",
    "assertions",
    "redaction"
  ],
  "properties": {
    "schema_version": { "const": "s11-host-delta-measurement/1.0" },
    "target": { "$ref": "#/$defs/target" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_sha256", "baseline_matrix_sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/safe_token" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "baseline_matrix_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/surface_measurement" }
    },
    "client_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/client_group" }
    },
    "feature_projection": { "$ref": "#/$defs/projection" },
    "app_server_projection": { "$ref": "#/$defs/projection" },
    "contract_projection_sha256": { "$ref": "#/$defs/sha256" },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_unchanged",
        "all_required_surfaces_measured",
        "signatures_verified",
        "manual_interaction_absent"
      ],
      "properties": {
        "package_unchanged": { "const": true },
        "all_required_surfaces_measured": { "const": true },
        "signatures_verified": { "const": true },
        "manual_interaction_absent": { "const": true }
      }
    },
    "redaction": { "$ref": "#/$defs/redaction" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safe_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$"
    },
    "nullable_safe_token": {
      "oneOf": [
        { "$ref": "#/$defs/safe_token" },
        { "type": "null" }
      ]
    },
    "nullable_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "const": "macos" },
        "architecture": { "const": "arm64" }
      }
    },
    "signature_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "identifier", "team_id", "cdhash"],
      "properties": {
        "mode": { "enum": ["strict", "deep_strict"] },
        "identifier": { "$ref": "#/$defs/safe_token" },
        "team_id": { "$ref": "#/$defs/safe_token" },
        "cdhash": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    },
    "nullable_signature": {
      "oneOf": [
        { "$ref": "#/$defs/signature_coordinate" },
        { "type": "null" }
      ]
    },
    "surface_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "host_name",
        "host_identifier",
        "host_artifact_kind",
        "host_version",
        "host_build",
        "host_commit",
        "host_artifact_sha256",
        "host_metadata_sha256",
        "host_code_signature",
        "client_version",
        "client_artifact_sha256",
        "client_code_signature",
        "ide_host_version",
        "ide_shell_identifier",
        "ide_shell_artifact_sha256",
        "ide_shell_team_id",
        "ide_shell_code_signature",
        "qualification"
      ],
      "properties": {
        "surface": { "enum": ["app", "cli", "ide"] },
        "host_name": { "$ref": "#/$defs/safe_token" },
        "host_identifier": { "$ref": "#/$defs/safe_token" },
        "host_artifact_kind": {
          "enum": ["macos_bundle_executable", "standalone_executable", "extension_tree"]
        },
        "host_version": { "$ref": "#/$defs/safe_token" },
        "host_build": { "$ref": "#/$defs/safe_token" },
        "host_commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "host_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "host_metadata_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "host_code_signature": { "$ref": "#/$defs/nullable_signature" },
        "client_version": { "$ref": "#/$defs/safe_token" },
        "client_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "client_code_signature": { "$ref": "#/$defs/signature_coordinate" },
        "ide_host_version": { "$ref": "#/$defs/nullable_safe_token" },
        "ide_shell_identifier": { "$ref": "#/$defs/nullable_safe_token" },
        "ide_shell_artifact_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "ide_shell_team_id": { "$ref": "#/$defs/nullable_safe_token" },
        "ide_shell_code_signature": { "$ref": "#/$defs/nullable_signature" },
        "qualification": { "const": "candidate" }
      }
    },
    "client_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_artifact_sha256", "surfaces"],
      "properties": {
        "client_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["app", "cli", "ide"] }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "complete", "sha256", "members"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/safe_token" },
        "complete": { "const": true },
        "sha256": { "$ref": "#/$defs/sha256" },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/safe_token" },
          "uniqueItems": true
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_paths_absent",
        "account_identity_absent",
        "artifact_content_absent",
        "environment_secrets_absent"
      ],
      "properties": {
        "absolute_paths_absent": { "const": true },
        "account_identity_absent": { "const": true },
        "artifact_content_absent": { "const": true },
        "environment_secrets_absent": { "const": true }
      }
    }
  }
}
