{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Bridge RPC 1.0 common types",
  "$defs": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "protocolVersionV1": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "handshakeVersion": {
      "const": "1.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^project:sha256:[0-9a-f]{64}$"
    },
    "editorSessionId": {
      "type": "string",
      "pattern": "^editor:[0-9a-f]{32}$"
    },
    "runtimeSessionId": {
      "type": "string",
      "pattern": "^runtime:[0-9a-f]{32}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^req:[A-Za-z0-9._-]+$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot:[0-9a-f]{32}$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^scene:[0-9a-f]{32}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^node:[0-9a-f]{32}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64Url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "context": {
      "type": "object",
      "required": [
        "project_id",
        "editor_session_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/projectId"
        },
        "editor_session_id": {
          "$ref": "#/$defs/editorSessionId"
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "name",
        "version",
        "readiness"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "version": {
          "$ref": "#/$defs/protocolVersion"
        },
        "readiness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "limits": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "required": [
        "frame_bytes",
        "default_deadline_ms",
        "max_deadline_ms",
        "max_in_flight_requests",
        "main_thread_commands_per_frame",
        "main_thread_budget_us",
        "ping_echo_bytes"
      ],
      "properties": {
        "frame_bytes": {
          "const": 1048576
        },
        "default_deadline_ms": {
          "const": 5000
        },
        "max_deadline_ms": {
          "const": 30000
        },
        "max_in_flight_requests": {
          "const": 64
        },
        "main_thread_commands_per_frame": {
          "const": 8
        },
        "main_thread_budget_us": {
          "const": 2000
        },
        "ping_echo_bytes": {
          "const": 256
        },
        "hard_message_bytes": {
          "const": 8388608
        },
        "snapshot_chunk_bytes": {
          "const": 524288
        },
        "event_journal_entries": {
          "const": 4096
        },
        "event_journal_bytes": {
          "const": 16777216
        },
        "snapshot_window_bytes": {
          "const": 33554432
        },
        "variant_depth": {
          "const": 8
        },
        "container_items": {
          "const": 1000
        },
        "editor_open_scenes": {
          "const": 64
        },
        "editor_selected_nodes": {
          "const": 256
        },
        "editor_inspector_properties": {
          "const": 512
        },
        "editor_open_scripts": {
          "const": 256
        },
        "editor_script_selections": {
          "const": 32
        },
        "editor_history_records": {
          "const": 128
        },
        "editor_diagnostics": {
          "const": 200
        },
        "editor_diagnostic_message_bytes": {
          "const": 16384
        },
        "editor_diagnostics_bytes": {
          "const": 262144
        },
        "editor_viewports": {
          "const": 16
        },
        "editor_projected_value_bytes": {
          "const": 65536
        },
        "runtime_tree_nodes": {
          "const": 10000
        },
        "runtime_tree_depth": {
          "const": 256
        },
        "runtime_snapshot_bytes": {
          "const": 16777216
        },
        "runtime_snapshot_timeout_ms": {
          "const": 10000
        },
        "runtime_event_journal_entries": {
          "const": 1024
        },
        "runtime_event_journal_bytes": {
          "const": 4194304
        },
        "runtime_properties": {
          "const": 512
        },
        "runtime_object_bytes": {
          "const": 262144
        },
        "runtime_diagnostics": {
          "const": 200
        },
        "runtime_diagnostic_message_bytes": {
          "const": 16384
        },
        "runtime_diagnostics_bytes": {
          "const": 262144
        },
        "runtime_stacks": {
          "const": 64
        },
        "runtime_stack_frames": {
          "const": 128
        },
        "runtime_stacks_bytes": {
          "const": 262144
        },
        "runtime_screenshot_width": {
          "const": 1280
        },
        "runtime_screenshot_height": {
          "const": 720
        },
        "runtime_screenshot_bytes": {
          "const": 524288
        },
        "runtime_screenshot_source_bytes": {
          "const": 33554432
        },
        "runtime_screenshot_interval_ms": {
          "const": 1000
        },
        "transaction_operations": {
          "const": 1
        },
        "transaction_prepared_records": {
          "const": 64
        },
        "transaction_applying_per_history": {
          "const": 1
        },
        "transaction_prepared_ttl_ms": {
          "const": 300000
        },
        "transaction_approval_timeout_ms": {
          "const": 120000
        },
        "transaction_receipt_ttl_ms": {
          "const": 30000
        },
        "transaction_clock_skew_ms": {
          "const": 2000
        },
        "transaction_approval_message_bytes": {
          "const": 8192
        },
        "transaction_preview_bytes": {
          "const": 65536
        },
        "transaction_operation_bytes": {
          "const": 65536
        },
        "transaction_variant_depth": {
          "const": 8
        },
        "transaction_container_items": {
          "const": 1000
        },
        "transaction_string_characters": {
          "const": 16384
        },
        "transaction_structural_nodes": {
          "const": 1000
        },
        "transaction_journal_records": {
          "const": 1024
        },
        "transaction_journal_bytes": {
          "const": 8388608
        },
        "transaction_status_bytes": {
          "const": 65536
        },
        "transaction_request_deadline_ms": {
          "const": 5000
        },
        "resource_records": {
          "const": 250000
        },
        "resource_dependencies": {
          "const": 2000000
        },
        "resource_dependencies_per_record": {
          "const": 4096
        },
        "resource_path_bytes": {
          "const": 1024
        },
        "resource_snapshot_chunk_bytes": {
          "const": 524288
        },
        "resource_delta_batch_bytes": {
          "const": 524288
        },
        "resource_journal_entries": {
          "const": 4096
        },
        "resource_journal_bytes": {
          "const": 16777216
        },
        "resource_snapshot_timeout_ms": {
          "const": 120000
        },
        "resource_snapshot_concurrency": {
          "const": 1
        },
        "script_documents": {
          "const": 250000
        },
        "script_symbols": {
          "const": 2000000
        },
        "script_relations": {
          "const": 4000000
        },
        "script_diagnostics": {
          "const": 2000000
        },
        "script_symbols_per_document": {
          "const": 65536
        },
        "script_relations_per_document": {
          "const": 262144
        },
        "script_diagnostics_per_document": {
          "const": 4096
        },
        "script_path_bytes": {
          "const": 1024
        },
        "script_name_bytes": {
          "const": 1024
        },
        "script_signature_bytes": {
          "const": 4096
        },
        "script_diagnostic_message_bytes": {
          "const": 2048
        },
        "script_snapshot_chunk_bytes": {
          "const": 524288
        },
        "script_delta_batch_bytes": {
          "const": 524288
        },
        "script_journal_entries": {
          "const": 4096
        },
        "script_journal_bytes": {
          "const": 16777216
        },
        "script_snapshot_timeout_ms": {
          "const": 120000
        },
        "script_snapshot_concurrency": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "revisionVector": {
      "type": "object",
      "required": [
        "editor_session_id",
        "event_seq",
        "project_revision",
        "operation_seq",
        "scene_revisions"
      ],
      "properties": {
        "editor_session_id": {
          "$ref": "#/$defs/editorSessionId"
        },
        "event_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operation_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resource_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scene_graph_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "script_graph_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runtime_session_id": {
          "$ref": "#/$defs/runtimeSessionId"
        },
        "runtime_event_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scene_revisions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "additionalProperties": true
    }
  }
}
