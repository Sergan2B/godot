{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Bridge RPC 1.1 editor snapshot and event stream",
  "oneOf": [
    { "$ref": "#/$defs/snapshotRequest" },
    { "$ref": "#/$defs/snapshotBegin" },
    { "$ref": "#/$defs/snapshotChunk" },
    { "$ref": "#/$defs/snapshotEnd" },
    { "$ref": "#/$defs/snapshotAck" },
    { "$ref": "#/$defs/syncEvent" },
    { "$ref": "#/$defs/syncInvalidated" }
  ],
  "$defs": {
    "snapshotRequestParams": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["editor_context", "editor_inspector"]
          }
        }
      },
      "additionalProperties": false
    },
    "snapshotRequest": {
      "allOf": [
        { "$ref": "rpc.schema.json#/$defs/request" },
        {
          "properties": {
            "protocol_version": { "const": "1.1" },
            "method": { "const": "editor.snapshot.get" },
            "params": { "$ref": "#/$defs/snapshotRequestParams" }
          }
        }
      ]
    },
    "snapshotLimits": {
      "type": "object",
      "required": [
        "snapshot_chunk_bytes",
        "negotiated_snapshot_chunk_bytes",
        "variant_depth",
        "container_items",
        "identity_characters",
        "projected_value_bytes",
        "inspector_bytes_per_node",
        "total_inspector_bytes",
        "truncated"
      ],
      "properties": {
        "snapshot_chunk_bytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
        "negotiated_snapshot_chunk_bytes": { "const": 524288 },
        "variant_depth": { "type": "integer", "minimum": 1, "maximum": 8 },
        "container_items": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "identity_characters": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "projected_value_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "inspector_bytes_per_node": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "total_inspector_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "snapshotAcceptedResult": {
      "type": "object",
      "required": ["snapshot_id", "base_event_seq", "revisions", "domains", "limits_applied"],
      "properties": {
        "snapshot_id": { "$ref": "common.schema.json#/$defs/snapshotId" },
        "base_event_seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "revisions": { "$ref": "common.schema.json#/$defs/revisionVector" },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["editor_context", "editor_inspector"] }
        },
        "limits_applied": { "$ref": "#/$defs/snapshotLimits" }
      },
      "additionalProperties": true
    },
    "snapshotBegin": {
      "allOf": [
        { "$ref": "rpc.schema.json#/$defs/notification" },
        {
          "properties": {
            "protocol_version": { "const": "1.1" },
            "method": { "const": "snapshot.begin" },
            "params": {
              "type": "object",
              "required": ["snapshot_id", "base_event_seq", "revisions", "chunk_count"],
              "properties": {
                "snapshot_id": { "$ref": "common.schema.json#/$defs/snapshotId" },
                "base_event_seq": { "type": "integer", "minimum": 0 },
                "revisions": { "$ref": "common.schema.json#/$defs/revisionVector" },
                "chunk_count": { "type": "integer", "minimum": 1, "maximum": 65536 }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "snapshotEntity": {
      "type": "object",
      "required": ["kind", "entity_id"],
      "properties": {
        "kind": { "enum": ["editor_state", "scene", "node"] },
        "entity_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": true
    },
    "snapshotChunk": {
      "allOf": [
        { "$ref": "rpc.schema.json#/$defs/chunk" },
        {
          "required": ["payload_json"],
          "properties": {
            "protocol_version": { "const": "1.1" },
            "payload_json": { "type": "string", "maxLength": 524288 },
            "payload": {
              "type": "object",
              "required": ["entities"],
              "properties": {
                "entities": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": { "$ref": "#/$defs/snapshotEntity" }
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "snapshotEnd": {
      "allOf": [
        { "$ref": "rpc.schema.json#/$defs/notification" },
        {
          "properties": {
            "protocol_version": { "const": "1.1" },
            "method": { "const": "snapshot.end" },
            "params": {
              "type": "object",
              "required": ["snapshot_id", "chunk_count", "entity_count", "checksum", "revisions"],
              "properties": {
                "snapshot_id": { "$ref": "common.schema.json#/$defs/snapshotId" },
                "chunk_count": { "type": "integer", "minimum": 1 },
                "entity_count": { "type": "integer", "minimum": 0 },
                "checksum": { "$ref": "common.schema.json#/$defs/sha256Hex" },
                "revisions": { "$ref": "common.schema.json#/$defs/revisionVector" }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "snapshotAck": {
      "allOf": [
        { "$ref": "rpc.schema.json#/$defs/ack" },
        {
          "properties": {
            "protocol_version": { "const": "1.1" },
            "params": {
              "type": "object",
              "required": ["snapshot_id", "through_chunk"],
              "properties": {
                "snapshot_id": { "$ref": "common.schema.json#/$defs/snapshotId" },
                "through_chunk": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "syncEvent": {
      "allOf": [
        { "$ref": "rpc.schema.json#/$defs/notification" },
        {
          "properties": {
            "protocol_version": { "const": "1.1" },
            "method": { "const": "sync.event" },
            "params": {
              "type": "object",
              "required": ["event_seq", "event_type", "revisions"],
              "properties": {
                "event_seq": { "type": "integer", "minimum": 1 },
                "event_type": { "enum": ["selection_changed", "scene_changed", "property_changed"] },
                "scene_id": { "$ref": "common.schema.json#/$defs/sceneId" },
                "property": { "type": "string", "maxLength": 256 },
                "revisions": { "$ref": "common.schema.json#/$defs/revisionVector" }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "syncInvalidated": {
      "allOf": [
        { "$ref": "rpc.schema.json#/$defs/notification" },
        {
          "properties": {
            "protocol_version": { "const": "1.1" },
            "method": { "const": "sync.invalidated" },
            "params": {
              "type": "object",
              "required": ["reason", "last_contiguous_event_seq"],
              "properties": {
                "reason": { "enum": ["journal_overflow", "snapshot_cancelled", "session_changed"] },
                "last_contiguous_event_seq": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    }
  }
}
