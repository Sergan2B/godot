{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Bridge conformance fixture manifest",
  "type": "object",
  "required": [
    "bundle_version",
    "cases"
  ],
  "properties": {
    "bundle_version": {
      "const": "1.4"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "schema",
            "sequence",
            "framing",
            "project_id_vector",
            "handshake_vector"
          ]
        },
        "expect": {
          "enum": [
            "valid",
            "invalid_schema",
            "protocol_error",
            "connection_close"
          ]
        },
        "fixture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "instance_pointer": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(/([^~/]|~0|~1)*)*$"
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "length_prefix_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "payload_fixture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generated_payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "fragment_sizes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048580
          }
        }
      },
      "additionalProperties": true
    }
  }
}
