{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Bridge project-bound discovery record",
  "type": "object",
  "required": [
    "discovery_schema",
    "project_id",
    "editor_session_id",
    "pid",
    "transport",
    "endpoint",
    "protocol_versions",
    "token_file",
    "created_at"
  ],
  "properties": {
    "discovery_schema": {
      "enum": [1, 2]
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "editor_session_id": {
      "$ref": "common.schema.json#/$defs/editorSessionId"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "transport": {
      "enum": ["uds", "tcp_loopback"]
    },
    "endpoint": {
      "type": "string"
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/protocolVersion"
      }
    },
    "token_file": {
      "const": ".godot/codex/session.token"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "discovery_schema": { "const": 1 },
          "transport": { "const": "uds" }
        },
        "required": ["discovery_schema", "transport"]
      },
      "then": {
        "properties": {
          "endpoint": {
            "pattern": "^\\.godot/codex/run/bridge-[0-9a-f]{32}\\.sock$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "discovery_schema": { "const": 1 },
          "transport": { "const": "tcp_loopback" }
        },
        "required": ["discovery_schema", "transport"]
      },
      "then": {
        "properties": {
          "endpoint": {
            "pattern": "^127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "discovery_schema": { "const": 2 } },
        "required": ["discovery_schema"]
      },
      "then": {
        "properties": {
          "transport": {
            "const": "uds"
          },
          "endpoint": {
            "pattern": "^/(?:private/)?tmp/gcx-[0-9]+/p-[0-9a-f]{32}/b-[0-9a-f]{32}\\.sock$"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
