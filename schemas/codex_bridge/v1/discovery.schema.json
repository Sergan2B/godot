{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Bridge project-local discovery record",
  "type": "object",
  "required": [
    "discovery_schema",
    "project_id",
    "editor_session_id",
    "pid",
    "transport",
    "endpoint",
    "protocol_versions",
    "token_file",
    "created_at"
  ],
  "properties": {
    "discovery_schema": {
      "const": 1
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "editor_session_id": {
      "$ref": "common.schema.json#/$defs/editorSessionId"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "transport": {
      "const": "uds"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^\\.godot/codex/run/bridge-[0-9a-f]{32}\\.sock$"
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/protocolVersion"
      }
    },
    "token_file": {
      "const": ".godot/codex/session.token"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  },
  "additionalProperties": true
}
