{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-codex.invalid/schemas/godot_codex/sprint11-multi-project-report.schema.json",
  "title": "Sprint 11 bounded multi-project live report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "platform",
    "protocol",
    "bridge_rpc",
    "artifacts",
    "registry",
    "projects",
    "assertions",
    "source_integrity",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "const": "s11-multi-project-live/1.0"
    },
    "status": {
      "const": "passed"
    },
    "platform": {
      "const": "macos-arm64"
    },
    "protocol": {
      "const": "2025-11-25"
    },
    "bridge_rpc": {
      "const": "1.8"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "godot_sha256",
        "sidecar_sha256"
      ],
      "properties": {
        "godot_sha256": {
          "$ref": "#/$defs/digest"
        },
        "sidecar_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "digest"
      ],
      "properties": {
        "tools": {
          "const": 41
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "b"
      ],
      "properties": {
        "a": {
          "$ref": "#/$defs/project"
        },
        "b": {
          "$ref": "#/$defs/project"
        }
      }
    },
    "assertions": {
      "$ref": "#/$defs/assertions"
    },
    "source_integrity": {
      "$ref": "#/$defs/project_flags"
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_a_stopped",
        "runtime_b_stopped",
        "editor_a_stopped",
        "editor_b_stopped",
        "sidecar_a_stopped",
        "sidecar_b_stopped"
      ],
      "properties": {
        "runtime_a_stopped": {
          "const": true
        },
        "runtime_b_stopped": {
          "const": true
        },
        "editor_a_stopped": {
          "const": true
        },
        "editor_b_stopped": {
          "const": true
        },
        "sidecar_a_stopped": {
          "const": true
        },
        "sidecar_b_stopped": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_identity_sha256",
        "editor_identity_sha256",
        "runtime_identity_sha256",
        "transaction_identity_sha256",
        "validation_report_identity_sha256",
        "operation_seq",
        "action_count",
        "approval_provider",
        "validation_outcome",
        "readback",
        "targeted_undo"
      ],
      "properties": {
        "project_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "editor_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "runtime_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "transaction_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "validation_report_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "operation_seq": {
          "$ref": "#/$defs/safe_integer"
        },
        "action_count": {
          "$ref": "#/$defs/safe_integer"
        },
        "approval_provider": {
          "const": "mcp_action_only_form_v1"
        },
        "validation_outcome": {
          "const": "passed"
        },
        "readback": {
          "const": true
        },
        "targeted_undo": {
          "const": true
        }
      }
    },
    "project_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "b"
      ],
      "properties": {
        "a": {
          "const": true
        },
        "b": {
          "const": true
        }
      }
    },
    "foreign_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "error_code",
        "is_error",
        "mutation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "approval_binding",
            "cursor",
            "project_id",
            "runtime_session_id",
            "transaction_id",
            "validation_report_id"
          ]
        },
        "error_code": {
          "enum": [
            "transaction_not_found",
            "stale_cursor",
            "wrong_project",
            "stale_runtime_session",
            "validation_report_not_found"
          ]
        },
        "is_error": {
          "const": true
        },
        "mutation": {
          "const": false
        }
      }
    },
    "fault_case_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "observed_code",
        "proof_source",
        "no_fallback",
        "no_cross_project_data",
        "no_cross_project_mutation",
        "no_cross_project_approval",
        "no_cross_project_transaction",
        "cleanup"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "observed_code": {
          "type": "string"
        },
        "proof_source": {
          "enum": [
            "live_two_project_processes",
            "public_runner_prelaunch_authority_plus_external_surface_attestation",
            "package_bound_prelaunch_authority_plus_external_surface_attestation"
          ]
        },
        "no_fallback": {
          "const": true
        },
        "no_cross_project_data": {
          "const": true
        },
        "no_cross_project_mutation": {
          "const": true
        },
        "no_cross_project_approval": {
          "const": true
        },
        "no_cross_project_transaction": {
          "const": true
        },
        "cleanup": {
          "const": true
        }
      }
    },
    "copied_discovery": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "copied_discovery"
            },
            "observed_code": {
              "enum": [
                "bridge_discovery_stale",
                "bridge_unreachable",
                "editor_offline",
                "project_binding_mismatch"
              ]
            }
          }
        }
      ]
    },
    "copied_token": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "copied_token"
            },
            "observed_code": {
              "enum": [
                "bridge_authentication_failed",
                "editor_offline"
              ]
            }
          }
        }
      ]
    },
    "swapped_discovery": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "swapped_discovery"
            },
            "observed_code": {
              "enum": [
                "bridge_discovery_stale",
                "bridge_unreachable",
                "editor_offline",
                "project_binding_mismatch"
              ]
            }
          }
        }
      ]
    },
    "swapped_token": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "swapped_token"
            },
            "observed_code": {
              "enum": [
                "bridge_authentication_failed",
                "editor_offline"
              ]
            }
          }
        }
      ]
    },
    "swapped_config": {
      "$ref": "#/$defs/project_binding_case"
    },
    "swapped_root": {
      "$ref": "#/$defs/project_binding_case"
    },
    "swapped_cwd": {
      "$ref": "#/$defs/project_binding_case"
    },
    "project_binding_case": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "observed_code": {
              "const": "project_binding_mismatch"
            }
          }
        }
      ]
    },
    "editor_restart": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "editor_restart"
            },
            "observed_code": {
              "const": "editor_reconnected"
            }
          }
        }
      ]
    },
    "cache_rebuild": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "cache_rebuild"
            },
            "observed_code": {
              "const": "cache_rebuilt"
            }
          }
        }
      ]
    },
    "package_mismatch": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "package_mismatch"
            },
            "observed_code": {
              "const": "package_binding_mismatch"
            }
          }
        }
      ]
    },
    "version_mismatch": {
      "allOf": [
        {
          "$ref": "#/$defs/fault_case_base"
        },
        {
          "properties": {
            "case_id": {
              "const": "version_mismatch"
            },
            "observed_code": {
              "const": "package_version_mismatch"
            }
          }
        }
      ]
    },
    "target_restart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "component",
        "process_instance_changed",
        "target_reconnected",
        "target_identity_preserved",
        "sibling_process_preserved",
        "sibling_editor_preserved",
        "sibling_runtime_preserved",
        "sibling_transaction_preserved",
        "sibling_validation_report_preserved",
        "sibling_readback_preserved",
        "sibling_revisions_preserved"
      ],
      "properties": {
        "target": {
          "const": "a"
        },
        "component": {
          "const": "sidecar"
        },
        "process_instance_changed": {
          "const": true
        },
        "target_reconnected": {
          "const": true
        },
        "target_identity_preserved": {
          "const": true
        },
        "sibling_process_preserved": {
          "const": true
        },
        "sibling_editor_preserved": {
          "const": true
        },
        "sibling_runtime_preserved": {
          "const": true
        },
        "sibling_transaction_preserved": {
          "const": true
        },
        "sibling_validation_report_preserved": {
          "const": true
        },
        "sibling_readback_preserved": {
          "const": true
        },
        "sibling_revisions_preserved": {
          "const": true
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parallel_reads",
        "parallel_runtime_start",
        "parallel_prepare",
        "parallel_apply",
        "separate_approvals",
        "validation_readback",
        "targeted_undo",
        "identity_distinct",
        "foreign_bindings",
        "target_restart",
        "fault_matrix"
      ],
      "properties": {
        "parallel_reads": {
          "const": true
        },
        "parallel_runtime_start": {
          "const": true
        },
        "parallel_prepare": {
          "const": true
        },
        "parallel_apply": {
          "const": true
        },
        "separate_approvals": {
          "const": true
        },
        "validation_readback": {
          "const": true
        },
        "targeted_undo": {
          "const": true
        },
        "identity_distinct": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "editor",
            "runtime",
            "transaction",
            "validation_report"
          ],
          "properties": {
            "project": {
              "const": true
            },
            "editor": {
              "const": true
            },
            "runtime": {
              "const": true
            },
            "transaction": {
              "const": true
            },
            "validation_report": {
              "const": true
            }
          }
        },
        "foreign_bindings": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/foreign_binding"
          }
        },
        "target_restart": {
          "$ref": "#/$defs/target_restart"
        },
        "fault_matrix": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "prefixItems": [
            {
              "$ref": "#/$defs/copied_discovery"
            },
            {
              "$ref": "#/$defs/copied_token"
            },
            {
              "$ref": "#/$defs/swapped_discovery"
            },
            {
              "$ref": "#/$defs/swapped_token"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/swapped_config"
                },
                {
                  "properties": {
                    "case_id": {
                      "const": "swapped_config"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/swapped_root"
                },
                {
                  "properties": {
                    "case_id": {
                      "const": "swapped_root"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/swapped_cwd"
                },
                {
                  "properties": {
                    "case_id": {
                      "const": "swapped_cwd"
                    }
                  }
                }
              ]
            },
            {
              "$ref": "#/$defs/editor_restart"
            },
            {
              "$ref": "#/$defs/cache_rebuild"
            },
            {
              "$ref": "#/$defs/package_mismatch"
            },
            {
              "$ref": "#/$defs/version_mismatch"
            }
          ],
          "items": false
        }
      }
    }
  }
}
