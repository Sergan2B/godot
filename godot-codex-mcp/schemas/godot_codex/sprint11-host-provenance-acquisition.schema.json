{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-codex.invalid/schemas/godot_codex/sprint11-host-provenance-acquisition.schema.json",
  "title": "Sprint 11 source-bound host provenance acquisition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_kind",
    "status",
    "source_commit",
    "bindings",
    "command",
    "assertions",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "const": "s11-host-provenance-acquisition/1.0"
    },
    "capture_kind": {
      "const": "real_local_host_provenance"
    },
    "status": {
      "const": "passed"
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_matched",
        "extension_tree_complete",
        "code_signatures_verified",
        "symlinks_rejected",
        "source_checkout_unchanged"
      ],
      "properties": {
        "profile_matched": {
          "const": true
        },
        "extension_tree_complete": {
          "const": true
        },
        "code_signatures_verified": {
          "const": true
        },
        "symlinks_rejected": {
          "const": true
        },
        "source_checkout_unchanged": {
          "const": true
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_paths_absent",
        "account_identity_absent",
        "artifact_content_absent",
        "environment_secrets_absent"
      ],
      "properties": {
        "absolute_paths_absent": {
          "const": true
        },
        "account_identity_absent": {
          "const": true
        },
        "artifact_content_absent": {
          "const": true
        },
        "environment_secrets_absent": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_path",
        "runner_sha256",
        "measurement_schema_path",
        "measurement_schema_sha256",
        "acquisition_schema_path",
        "acquisition_schema_sha256",
        "host_coordinate_profile_path",
        "host_coordinate_profile_sha256",
        "measurement_path",
        "measurement_sha256"
      ],
      "properties": {
        "runner_path": {
          "const": "tests/codex/sprint11_host_provenance.py"
        },
        "runner_sha256": {
          "$ref": "#/$defs/digest"
        },
        "measurement_schema_path": {
          "const": "godot-codex-mcp/schemas/godot_codex/sprint11-host-provenance.schema.json"
        },
        "measurement_schema_sha256": {
          "$ref": "#/$defs/digest"
        },
        "acquisition_schema_path": {
          "const": "godot-codex-mcp/schemas/godot_codex/sprint11-host-provenance-acquisition.schema.json"
        },
        "acquisition_schema_sha256": {
          "$ref": "#/$defs/digest"
        },
        "host_coordinate_profile_path": {
          "const": "godot-codex-mcp/product/host-coordinate-profile.v1.json"
        },
        "host_coordinate_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "measurement_path": {
          "$ref": "#/$defs/path"
        },
        "measurement_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cwd",
        "argv_template",
        "command_sha256",
        "runner_path",
        "runner_sha256",
        "stdout_sha256",
        "stderr_sha256",
        "exit_code",
        "duration_ms",
        "report_path",
        "report_sha256"
      ],
      "properties": {
        "id": {
          "const": "host_provenance"
        },
        "cwd": {
          "const": "."
        },
        "argv_template": {
          "const": [
            "{python}",
            "-E",
            "-s",
            "-S",
            "tests/codex/sprint11_host_provenance.py",
            "--profile",
            "{profile}",
            "--app-bundle",
            "{app_bundle}",
            "--app-executable",
            "{app_executable}",
            "--app-client",
            "{app_client}",
            "--vscode-bundle",
            "{vscode_bundle}",
            "--vscode-executable",
            "{vscode_executable}",
            "--extension-root",
            "{extension_root}",
            "--extension-package-json",
            "{extension_package_json}",
            "--ide-client",
            "{ide_client}",
            "--output",
            "{measurement}"
          ]
        },
        "command_sha256": {
          "$ref": "#/$defs/digest"
        },
        "runner_path": {
          "const": "tests/codex/sprint11_host_provenance.py"
        },
        "runner_sha256": {
          "$ref": "#/$defs/digest"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/digest"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/digest"
        },
        "exit_code": {
          "const": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180000
        },
        "report_path": {
          "$ref": "#/$defs/path"
        },
        "report_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
