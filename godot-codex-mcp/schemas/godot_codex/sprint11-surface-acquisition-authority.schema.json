{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-codex.invalid/schemas/godot_codex/sprint11-surface-acquisition-authority.schema.json",
  "title": "Sprint 11 external Codex surface acquisition authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_kind",
    "trust_boundary",
    "operator_id",
    "surface",
    "artifact_directory",
    "bindings",
    "observations",
    "attestation_projection_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "s11-surface-acquisition-authority/1.0"
    },
    "authority_kind": {
      "const": "external_operator_attestation"
    },
    "trust_boundary": {
      "const": "git_binds_exact_surface_artifacts_external_operator_attests_actual_host_session_without_cryptographic_process_origin_proof"
    },
    "operator_id": {
      "type": "string",
      "pattern": "^operator:sha256:[0-9a-f]{64}$"
    },
    "surface": {
      "enum": [
        "app",
        "cli",
        "ide"
      ]
    },
    "artifact_directory": {
      "type": "string",
      "pattern": "^tests/codex/acquisition/sprint11/surfaces/(app|cli|ide)$"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "attestation_projection_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^tests/codex/acquisition/sprint11/surfaces/(app|cli|ide)/(trace|recorder-journal)\\.json$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_source_commit",
        "package_manifest_sha256",
        "host_provenance_sha256",
        "host_artifact_sha256",
        "client_artifact_sha256",
        "mcp_binary_sha256",
        "project_fixture_sha256",
        "prompt_pack_sha256",
        "trace_path",
        "trace_sha256",
        "recorder_journal_path",
        "recorder_journal_sha256"
      ],
      "properties": {
        "package_source_commit": {
          "$ref": "#/$defs/commit"
        },
        "package_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "host_provenance_sha256": {
          "$ref": "#/$defs/digest"
        },
        "host_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "client_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "mcp_binary_sha256": {
          "$ref": "#/$defs/digest"
        },
        "project_fixture_sha256": {
          "$ref": "#/$defs/digest"
        },
        "prompt_pack_sha256": {
          "$ref": "#/$defs/digest"
        },
        "trace_path": {
          "$ref": "#/$defs/artifact_path"
        },
        "trace_sha256": {
          "$ref": "#/$defs/digest"
        },
        "recorder_journal_path": {
          "$ref": "#/$defs/artifact_path"
        },
        "recorder_journal_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_surface_session_observed",
        "official_host_process_observed",
        "recorder_stdio_bound_to_host_session",
        "exact_project_root_observed",
        "project_trust_reviewed_and_accepted",
        "nested_cwd_resolution_observed",
        "project_config_reload_observed",
        "package_launcher_observed",
        "sandbox_approval_observed",
        "form_accept_observed",
        "form_decline_observed",
        "form_cancel_observed",
        "form_timeout_observed",
        "foreign_project_config_rejected",
        "foreign_project_root_rejected",
        "foreign_project_cwd_rejected",
        "package_digest_mismatch_rejected_before_launch",
        "package_version_mismatch_rejected_before_launch",
        "cross_project_fallback_absent",
        "developer_bypass_absent"
      ],
      "properties": {
        "actual_surface_session_observed": {
          "const": true
        },
        "official_host_process_observed": {
          "const": true
        },
        "recorder_stdio_bound_to_host_session": {
          "const": true
        },
        "exact_project_root_observed": {
          "const": true
        },
        "project_trust_reviewed_and_accepted": {
          "const": true
        },
        "nested_cwd_resolution_observed": {
          "const": true
        },
        "project_config_reload_observed": {
          "const": true
        },
        "package_launcher_observed": {
          "const": true
        },
        "sandbox_approval_observed": {
          "const": true
        },
        "form_accept_observed": {
          "const": true
        },
        "form_decline_observed": {
          "const": true
        },
        "form_cancel_observed": {
          "const": true
        },
        "form_timeout_observed": {
          "const": true
        },
        "foreign_project_config_rejected": {
          "const": true
        },
        "foreign_project_root_rejected": {
          "const": true
        },
        "foreign_project_cwd_rejected": {
          "const": true
        },
        "package_digest_mismatch_rejected_before_launch": {
          "const": true
        },
        "package_version_mismatch_rejected_before_launch": {
          "const": true
        },
        "cross_project_fallback_absent": {
          "const": true
        },
        "developer_bypass_absent": {
          "const": true
        }
      }
    }
  }
}
