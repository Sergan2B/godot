{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-codex.local/schemas/compatibility-matrix-v1.json",
  "title": "Godot Codex External Beta compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "package",
    "godot",
    "protocols",
    "schemas",
    "registry",
    "bridge_profiles",
    "surfaces"
  ],
  "properties": {
    "schema_version": {
      "const": "godot-codex-compatibility-matrix/1.0"
    },
    "matrix_id": {
      "$ref": "#/$defs/identifier"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "godot": {
      "$ref": "#/$defs/godot"
    },
    "protocols": {
      "$ref": "#/$defs/protocols"
    },
    "schemas": {
      "$ref": "#/$defs/schemas"
    },
    "registry": {
      "$ref": "#/$defs/registry"
    },
    "bridge_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/bridge_profile"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/surface_rule"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._+:/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "enum": [
            "macos",
            "linux",
            "windows"
          ]
        },
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "target"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "godot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "build_id",
        "artifact_sha256",
        "target"
      ],
      "properties": {
        "source_commit": {
          "$ref": "#/$defs/identifier"
        },
        "build_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge_major",
        "bridge_min_minor",
        "bridge_current_minor",
        "mcp_protocol",
        "approval_protocol_floor",
        "requires_form_elicitation"
      ],
      "properties": {
        "bridge_major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "bridge_min_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bridge_current_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "mcp_protocol": {
          "$ref": "#/$defs/identifier"
        },
        "approval_protocol_floor": {
          "$ref": "#/$defs/identifier"
        },
        "requires_form_elicitation": {
          "type": "boolean"
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "transaction_journal",
        "validation_report"
      ],
      "properties": {
        "index": {
          "$ref": "#/$defs/identifier"
        },
        "transaction_journal": {
          "$ref": "#/$defs/identifier"
        },
        "validation_report": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "digest",
        "tool_count",
        "fixed_resource_count",
        "resource_template_count"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "tool_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "fixed_resource_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "resource_template_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "compatibility_status": {
      "enum": [
        "supported",
        "compatible_reduced",
        "incompatible",
        "not_tested"
      ]
    },
    "surface_qualification": {
      "enum": [
        "candidate",
        "supported",
        "compatible_reduced",
        "incompatible",
        "not_tested"
      ]
    },
    "bridge_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "bridge_minor",
        "capabilities",
        "qualification"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "bridge_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "capabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "qualification": {
          "$ref": "#/$defs/compatibility_status"
        }
      }
    },
    "surface_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "host_version",
        "ide_host_version",
        "target",
        "qualification"
      ],
      "properties": {
        "surface": {
          "enum": [
            "app",
            "cli",
            "ide",
            "cursor"
          ]
        },
        "host_version": {
          "$ref": "#/$defs/identifier"
        },
        "ide_host_version": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "qualification": {
          "$ref": "#/$defs/surface_qualification"
        }
      }
    }
  }
}
